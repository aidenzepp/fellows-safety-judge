# Copy to .env and edit. .env is gitignored, and this file must never hold secrets.
# src/safety_judge/settings.py reads every name below; unknown SAFETY_JUDGE_* names
# are rejected so a typo fails loudly.

# One of: development, test, production
SAFETY_JUDGE_RUNTIME_ENVIRONMENT=development

# One of: DEBUG, INFO, WARNING, ERROR, CRITICAL
SAFETY_JUDGE_LOGGING_LEVEL=INFO
